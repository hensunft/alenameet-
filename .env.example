# Токен бота от @BotFather (только для сервера, не попадает во фронтенд)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# ID чата, куда бот будет присылать ответ (ваш личный chat id)
TELEGRAM_CHAT_ID=123456789

# Необязательно: публичный адрес сайта для Open Graph превью.
# На Vercel подставляется автоматически из VERCEL_PROJECT_PRODUCTION_URL.
# SITE_URL=https://alena.example.com
